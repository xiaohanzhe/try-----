FROM qwen2.5:3b

# 会话窗口与采样参数。
#
# 为什么必须写在这里而不是请求里：
#   App 走的是 Ollama 的 OpenAI 兼容端点 /v1/chat/completions，
#   实测该端点**不接受** num_ctx 与 repeat_penalty —— 无论放在顶层还是
#   塞进 options，都会被静默忽略（长提示词恒定截断在 ~2050 tokens）。
#   只有 Ollama 原生 /api/chat 的 options.num_ctx 生效，或写进这里。
#   对照组实测：/v1 + num_ctx=8192 → prompt_tokens=2050；
#               /api/chat + options.num_ctx=8192 → prompt_tokens=5032。
#
# 角色设定**不放在这里**：单一真源是 ralsei_pet/assets/ralsei_persona.md，
# 由 App 每次请求作为 system 发出（Ollama 会用 messages 里的 system 整体替换本文件的 SYSTEM）。

# 窗口：模型支持 32768，默认只有 ~2048，装不下人设 + 历史 + 记忆
PARAMETER num_ctx 8192

# 采样：比默认 0.8 略高一点更活，但要靠输出护栏兜住小模型的续写失态
PARAMETER temperature 0.85
PARAMETER top_p 0.92

# 重复惩罚：抑制"你还好吗／要不要休息一下"这类模板复读
PARAMETER repeat_penalty 1.15

# 单次输出上限，与 App 侧 max_tokens 一致
PARAMETER num_predict 256
